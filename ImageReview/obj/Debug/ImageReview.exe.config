    <add name="ImageReview.Properties.Settings.tempconn" connectionString="Data Source=ACCSERVER\SQLEXPRESS;Initial Catalog=Barcodesys;User ID=sa;Password=corporate" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="dbPwd" value="@Cashier123" />
    <add key="dbServer" value="192.168.1.18" />
    <add key="dbUser" value="cashier" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <userSettings>
    <ImageReview.Properties.Settings>
      <setting name="UserName" serializeAs="String">
        <value />
      </setting>
      <setting name="Password" serializeAs="String">
        <value />
      </setting>
      <setting name="CorrectionPath" serializeAs="String">
        <value>Z:\</value>
      </setting>
      <setting name="AdminReviewPath" serializeAs="String">
